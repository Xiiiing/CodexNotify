{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexNotify",
  "version": "1.1.0",
  "identifier": "com.xiiiing.codex-notify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "CodexNotify", "width": 1240, "height": 800, "minWidth": 980, "minHeight": 680 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
